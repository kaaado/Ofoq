# AMANA Public Website Environment Configuration
# Copy this file to .env.local for local development.

# --------------------------------------------------------------------------
# SUPABASE WAITLIST STORAGE CONFIGURATION
# --------------------------------------------------------------------------
# Required for real Supabase persistence. If left empty, the application
# gracefully falls back to the robust Local Storage / Export queue so that
# zero submissions are lost.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --------------------------------------------------------------------------
# OFFICIAL CONTACT CHANNELS (PLACEHOLDERS REQUIRING PO VALIDATION)
# --------------------------------------------------------------------------
# The official AMANA contact email (e.g. contact@amana-dz.com)
VITE_CONTACT_EMAIL=contact@amana.dz

# The official AMANA telephone assistance line (e.g. +213 21 00 00 00)
VITE_CONTACT_PHONE=+213 23 00 00 00

# Emergency protection hotline (Algerian Protection Civile)
VITE_EMERGENCY_HOTLINE=14

# Initial pilot territory
VITE_PILOT_WILAYA=Alger (16)
